# ==========================================================================
# ALVORA IT SOLUTION — ENVIRONMENT VARIABLES
#
# Setup:
#   1. Copy this file to `.env` in the project root (not `.env.example`
#      itself — Prisma and Next.js both auto-load `.env`, not `.env.example`).
#   2. Fill in real values for anything marked REQUIRED before running
#      `npm run dev`. Values below are safe local-development defaults
#      wherever one exists — replace them with real credentials for
#      anything you need to actually work (email sending, file upload).
#   3. Never commit `.env` — it's already in .gitignore.
#
# See README.md → "Local Development Setup" for full setup instructions,
# including how to get a local Postgres database running.
# ==========================================================================

# --- Database (Prisma / PostgreSQL) — REQUIRED ---
# This is the one variable that MUST be set correctly for `npx prisma
# validate`, `npx prisma generate`, and the dev server to start at all —
# without a `.env` file defining it, Prisma fails immediately with
# "Environment variable not found: DATABASE_URL".
#
# The value below matches the docker-compose.yml included in this repo
# (`docker compose up -d` starts a local Postgres on this exact port
# with these exact credentials) — use it as-is if you're using Docker,
# or replace it with your own local/cloud Postgres connection string.
DATABASE_URL="postgresql://alvora:alvora_dev_password@localhost:5432/alvora_dev?schema=public"

# --- Auth.js — REQUIRED ---
# Generate a real secret with: openssl rand -base64 32
# (Windows without OpenSSL: use `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
# The placeholder below works for local development but must be replaced
# before any shared/staging/production deployment.
AUTH_SECRET="local-development-secret-replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# --- Seed script (prisma/seed.ts) — REQUIRED before running `npm run prisma:seed` ---
# Sets the password for the first Owner login this script creates
# (owner@alvoraitsolution.com). Change this password via the app after
# your first sign-in — don't leave the seeded credential in place beyond
# initial setup, even locally.
SEED_OWNER_PASSWORD="local-dev-password-change-me"

# --- Cloudinary (media storage) — OPTIONAL for local development ---
# Only required if you're testing Media Library uploads, résumé
# uploads on Careers, or team-photo uploads in the Admin Dashboard.
# Everything else runs fine with these left blank — image URLs already
# in the seeded/bundled content will still render. Get free credentials
# at https://cloudinary.com (Dashboard → API Keys) — see README §"Common
# Troubleshooting" if uploads fail with these unset.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (transactional email) — OPTIONAL for local development ---
# Only required if you're testing the Contact/Quote/Career confirmation
# emails or internal notifications. Without a real key, `src/lib/email.ts`
# logs the failure to the console and the form submission itself still
# succeeds (email sending is intentionally non-blocking) — so local dev
# of the forms works fine without this. Get a free key at
# https://resend.com (Dashboard → API Keys).
RESEND_API_KEY=""
EMAIL_FROM="Alvora IT Solution <hello@alvoraitsolution.com>"
EMAIL_TO_SALES="sales@alvoraitsolution.com"

# --- Site — OPTIONAL, reserved for future use ---
# Not currently read anywhere in the codebase (site.ts uses a hardcoded
# URL constant instead) — safe to leave as-is or blank for local dev.
# Kept here so it's ready if/when that's wired up, and to document that
# it is NOT currently required despite appearing alongside vars that are.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Analytics — OPTIONAL, reserved for future use ---
# Not currently read anywhere in the codebase. Leave blank for local dev.
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
